{
  "Orbit Store": {
    "prefix": "os-store",
    "body": [
      "import 'package:orbit_state/orbit.dart';",
      "",
      "class ${1:Counter}Store extends OrbitStore {",
      "  ${2:int} _${3:count} = ${4:0};",
      "  ${2:int} get ${3:count} => _${3:count};",
      "",
      "  void increment() {",
      "    mutate(() => _${3:count}++);",
      "  }",
      "",
      "  @override",
      "  Map<String, Object?> snapshot() => {'${3:count}': _${3:count}};",
      "}",
      "",
      "final ${1/(.*)/${1:/camelcase}/}Store = defineStore(() => ${1:Counter}Store());"
    ],
    "description": "Creates an OrbitStore class with private state, getter, mutate method, snapshot and defineStore singleton"
  },
  "Orbit Store Full": {
    "prefix": "os-store-full",
    "body": [
      "import 'package:orbit_state/orbit.dart';",
      "",
      "class ${1:User}Store extends OrbitStore {",
      "  ${2:bool} _${3:isLoading} = false;",
      "  ${2:bool} get ${3:isLoading} => _${3:isLoading};",
      "",
      "  @override",
      "  Future<void> init() async {",
      "    // One-time async setup (e.g. load from storage)",
      "  }",
      "",
      "  @override",
      "  void onResume() {",
      "    // App came back to foreground",
      "  }",
      "",
      "  @override",
      "  void onDispose() {",
      "    // Cancel timers/subscriptions",
      "  }",
      "",
      "  @override",
      "  Map<String, Object?> snapshot() => {'${3:isLoading}': _${3:isLoading}};",
      "}",
      "",
      "final ${1/(.*)/${1:/camelcase}/}Store = defineStore(() => ${1:User}Store());"
    ],
    "description": "Creates an OrbitStore with lifecycle hooks (init, onResume, onDispose) and snapshot"
  },
  "Orbit Builder": {
    "prefix": "os-builder",
    "body": [
      "OrbitBuilder<${1:CounterStore}>(",
      "  store: ${2:counterStore},",
      "  builder: (context, store, child) {",
      "    return ${3:Text('\\${store.${4:value}}')};",
      "  },",
      ")"
    ],
    "description": "Inserts an OrbitBuilder widget listening to an OrbitStore"
  },
  "Orbit Builder with Child": {
    "prefix": "os-builder-child",
    "body": [
      "OrbitBuilder<${1:CounterStore}>(",
      "  store: ${2:counterStore},",
      "  child: ${3:const StaticWidget()},",
      "  builder: (context, store, child) {",
      "    return Row(",
      "      children: [",
      "        child!,",
      "        Text('\\${store.${4:value}}'),",
      "      ],",
      "    );",
      "  },",
      ")"
    ],
    "description": "Inserts an OrbitBuilder widget with static child caching"
  },
  "Orbit Ref Builder": {
    "prefix": "os-ref-builder",
    "body": [
      "${1:counterStore}.builder(",
      "  builder: (context, store, child) {",
      "    return ${2:Text('\\${store.${3:value}}')};",
      "  },",
      ")"
    ],
    "description": "Inserts an OrbitStoreRef.builder widget call"
  },
  "Orbit Selector": {
    "prefix": "os-selector",
    "body": [
      "OrbitSelector<${1:CounterStore}, ${2:int}>(",
      "  store: ${3:counterStore},",
      "  selector: (store) => store.${4:value},",
      "  builder: (context, ${4:value}) {",
      "    return ${5:Text('\\$${4:value}')};",
      "  },",
      ")"
    ],
    "description": "Inserts an OrbitSelector widget for selective slice re-renders"
  },
  "Orbit Ref Select": {
    "prefix": "os-ref-select",
    "body": [
      "${1:counterStore}.select(",
      "  selector: (store) => store.${2:value},",
      "  builder: (context, ${2:value}) {",
      "    return ${3:Text('\\$${2:value}')};",
      "  },",
      ")"
    ],
    "description": "Inserts an OrbitStoreRef.select widget call"
  },
  "Orbit Scope": {
    "prefix": "os-scope",
    "body": [
      "OrbitScope<${1:FormStore}>(",
      "  create: () => ${1:FormStore}(),",
      "  child: ${2:const FormWidget()},",
      ")"
    ],
    "description": "Inserts an OrbitScope widget to bound store lifetime to subtree"
  },
  "Orbit Context Watch": {
    "prefix": "os-context",
    "body": [
      "final ${1:store} = context.orbit<${2:MyStore}>();"
    ],
    "description": "Accesses nearest OrbitScope store and subscribes BuildContext to changes"
  },
  "Orbit Context Read": {
    "prefix": "os-context-read",
    "body": [
      "final ${1:store} = context.orbitRead<${2:MyStore}>();"
    ],
    "description": "Reads Orbit store without subscribing BuildContext (for event handlers)"
  },
  "Orbit Mutate": {
    "prefix": "os-mutate",
    "body": [
      "mutate(() => _${1:state} = ${2:newValue});"
    ],
    "description": "Inserts a mutate call inside OrbitStore"
  },
  "Orbit Mutate Async": {
    "prefix": "os-mutate-async",
    "body": [
      "await mutateAsync<${1:T}>(",
      "  label: '${2:actionName}',",
      "  action: () async {",
      "    ${3:// long-running async work}",
      "    return ${4:result};",
      "  },",
      "  apply: (result) => _${5:state} = result,",
      "  onError: (e, st) => ${6:/* handle error */},",
      ");"
    ],
    "description": "Inserts a mutateAsync call inside OrbitStore decoupling async operations from safe state commits"
  },
  "Orbit Batch": {
    "prefix": "os-batch",
    "body": [
      "batch(() {",
      "  ${1:// mutations to commit in a single notification & undo step}",
      "});"
    ],
    "description": "Defers notifyListeners() across all mutations inside the batch and groups them into a single atomic undo step"
  },
  "Orbit Undoable Store": {
    "prefix": "os-undoable",
    "body": [
      "class ${1:Counter}Store extends OrbitStore with Undoable {",
      "  ${2:int} _${3:value} = ${4:0};",
      "  ${2:int} get ${3:value} => _${3:value};",
      "",
      "  void update${3/(.*)/${1:/capitalize}/}(${2:int} newValue) {",
      "    mutate(() => _${3:value} = newValue);",
      "  }",
      "",
      "  @override",
      "  Map<String, Object?> snapshot() => {'${3:value}': _${3:value}};",
      "",
      "  @override",
      "  void restore(Map<String, Object?> state) {",
      "    _${3:value} = state['${3:value}'] as ${2:int};",
      "  }",
      "}",
      "",
      "final ${1/(.*)/${1:/camelcase}/}Store = defineStore(() => ${1:Counter}Store());"
    ],
    "description": "Creates an OrbitStore with Undoable mixin for global undo/redo history"
  },
  "Orbit Observer Middleware": {
    "prefix": "os-observe",
    "body": [
      "final ${1:unsubscribe} = Orbit.observe((store, mutation) {",
      "  ${2:print('[\\${store.runtimeType}] \\${mutation.action} — \\${mutation.after}');}",
      "});"
    ],
    "description": "Inserts an Orbit.observe mutation listener middleware"
  },
  "Orbit Computed Store": {
    "prefix": "os-computed",
    "body": [
      "final ${1:derivedStore} = defineStore(() => ComputedStore<${2:int}>((watch) {",
      "  final ${3:dep} = watch(${4:sourceStore});",
      "  return ${5:dep.count * 2};",
      "}));"
    ],
    "description": "Creates a ComputedStore that derives state from other stores using watch(). watch() returns the store instance — access its getters directly."
  },
  "Orbit Future Provider": {
    "prefix": "os-future-provider",
    "body": [
      "final ${1:dataProvider} = defineStore(() => FutureProvider<${2:String}>(() async {",
      "  ${3:// Fetch async data}",
      "  return ${4:value};",
      "}));"
    ],
    "description": "Creates a FutureProvider store to manage and cache async Future state"
  },
  "Orbit Stream Provider": {
    "prefix": "os-stream-provider",
    "body": [
      "final ${1:dataProvider} = defineStore(() => StreamProvider<${2:String}>(() {",
      "  return ${3:stream};",
      "}));"
    ],
    "description": "Creates a StreamProvider store to subscribe to and manage a Stream of state"
  },
  "Orbit Debounce": {
    "prefix": "os-debounce",
    "body": [
      "debounce('${1:debounceId}', const Duration(milliseconds: ${2:300}), () async {",
      "  ${3:// action logic}",
      "});"
    ],
    "description": "Debounces an action directly inside an OrbitStore with auto-disposal safety"
  },
  "Orbit Throttle": {
    "prefix": "os-throttle",
    "body": [
      "throttle('${1:throttleId}', const Duration(milliseconds: ${2:300}), () async {",
      "  ${3:// action logic}",
      "});"
    ],
    "description": "Throttles an action directly inside an OrbitStore with auto-disposal safety"
  }
}

